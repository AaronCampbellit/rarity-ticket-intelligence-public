scope: ${RARITY_CLUSTER_NAME}
namespace: /rarity/postgres/
name: ${RARITY_NODE_NAME}

restapi:
  listen: ${RARITY_NODE_IP}:8008
  connect_address: ${RARITY_NODE_IP}:8008
  certfile: /run/rarity-tls/patroni/server.crt
  keyfile: /run/rarity-tls/patroni/server.key
  cafile: /run/rarity-tls/ca/ca.crt
  verify_client: required

etcd3:
  hosts:
    - ${RARITY_NODE_1_IP}:2379
    - ${RARITY_NODE_2_IP}:2379
    - ${RARITY_NODE_3_IP}:2379
  protocol: https
  cacert: /run/rarity-tls/ca/ca.crt
  cert: /run/rarity-tls/etcd/client.crt
  key: /run/rarity-tls/etcd/client.key

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    synchronous_mode: true
    synchronous_mode_strict: true
    synchronous_node_count: 1
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        archive_mode: "on"
        archive_timeout: 60s
        archive_command: >-
          pgbackrest --stanza=${PGBACKREST_STANZA} archive-push %p
        ssl: "on"
        ssl_cert_file: /run/rarity-tls/postgres/server.crt
        ssl_key_file: /run/rarity-tls/postgres/server.key
        ssl_ca_file: /run/rarity-tls/ca/ca.crt
        ssl_min_protocol_version: TLSv1.2
        password_encryption: scram-sha-256
        wal_level: replica
        hot_standby: "on"

  initdb:
    - encoding: UTF8
    - data-checksums

  pg_hba:
    - local all all peer
    - hostssl replication ${POSTGRES_REPLICATION_USER} ${RARITY_CLUSTER_CIDR} scram-sha-256
    - hostssl all all ${RARITY_CLUSTER_CIDR} scram-sha-256

  users:
    ${POSTGRES_ADMIN_USER}:
      password: ${POSTGRES_ADMIN_PASSWORD}
      options:
        - createrole
        - createdb

postgresql:
  listen: ${RARITY_NODE_IP}:5433
  connect_address: ${RARITY_NODE_IP}:5433
  data_dir: /var/lib/postgresql/data
  authentication:
    replication:
      username: ${POSTGRES_REPLICATION_USER}
      password: ${POSTGRES_REPLICATION_PASSWORD}
    superuser:
      username: ${POSTGRES_SUPERUSER}
      password: ${POSTGRES_SUPERUSER_PASSWORD}
    rewind:
      username: ${POSTGRES_REWIND_USER}
      password: ${POSTGRES_REWIND_PASSWORD}
  pgpass: /run/patroni/pgpass

watchdog:
  mode: required
  device: /dev/watchdog
  safety_margin: 5

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
